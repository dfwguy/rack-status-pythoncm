# NVIS Rack Status — launch configuration (EXAMPLE: every setting this file can carry)
#
# GENERATED by bin/gen-config-example.py from backend/config_registry.py. Do not hand-edit:
# add or change the declaration and regenerate, or the example drifts from the code that reads
# it.
#
# Start from the minimal file instead: `python backend/cli.py init-config --ssh-host <head>`
# writes `config/rackstatus.toml` with only what a deployment needs. Copy lines from here into
# it as you need them — every line below is commented out, so nothing here takes effect by
# itself. Point elsewhere with NVIS_RACKSTATUS_CONFIG=/path/to/file.
#
# PRECEDENCE — this file is the baseline. A real environment variable, or a `docker run -e`
# flag, overrides anything here. So a site can keep a checked-in-shape file and still override
# one setting for a single run.
#
# TABLES GROUP, THEY DO NOT NAMESPACE. A leaf key is the exact environment variable name:
# `[auth] RACK_WEB_OIDC_ISSUER = "..."` sets RACK_WEB_OIDC_ISSUER, not
# AUTH_RACK_WEB_OIDC_ISSUER. The same key in two tables is refused, since file order would
# otherwise decide its value.
#
# NO SECRETS. A setting resolved as secret makes startup fail if it appears here — this file
# is exactly the artifact that ends up in bug reports and support bundles, and a copy of it
# does not inherit .gitignore. Put secrets in the environment or a mounted secret.
#
# FLOATS ARE REFUSED. Quote version-like values: `"13.3"`, not `13.3`. Rendering a float
# changes it (13.30 becomes 13.3), and the settings shaped that way here are version strings
# compared as strings.
#
# NOT CONFIGURABLE HERE: RACK_WEB_BIND_ADDR, RACK_WEB_PORT, RACK_SSH_KEY_PATH,
# RACK_WEB_TLS_CERT, RACK_WEB_TLS_KEY and NVIS_RACKSTATUS_CONFIG. docker-compose.yml
# interpolates the first three to publish the port and mount the SSH key, which Docker
# resolves before Python starts — keep them in `.env`. The certificate is settled before this
# file is read: put yours in `config/tls/` (or set the two variables in the environment). The
# last cannot name the path to itself.

[general]
# Re-open the first-run setup wizard even though a project is already configured. What `cli.py
# serve --setup-wizard` sets; normally left unset, since the wizard offers itself when no
# operator-created project exists.
# NVIS_FORCE_SETUP_WIZARD = false

# Log level. Settable here because the config file is read before logging is configured, which
# is the reason the loader's own records appear slightly late.
# NVIS_LOG_LEVEL = "INFO"

# Synthetic data, no cluster contact. True on a developer laptop, and it also exempts the
# connection settings from the required-setting preflight.
# RACK_STATUS_DEMO = false


[connection]
# Base directory the bug-report and NVLMapper outputs are written to on each node (pdsh) and
# read from on the dashboard host (the Reports page). Point it at the project's own prefix -- a
# directory the service account can create and the dashboard host can see over the shared mount.
# Default /home/cmsupport/reports exists on only one appliance, so most deployments set this.
# NVLMapper's base (RACK_NVLMAPPER_REPORTS_BASE) defaults to it, so one value moves both.
# RACK_BUG_REPORT_REMOTE_DIR = "/home/cmods/bringup-data/reports"

# How commands reach the cluster: 'ssh' or 'local'. Deprecated in favour of the topology-based
# transport config, and 'ssh' is the default; kept because deployed sites still set it.
# RACK_EXEC_MODE = "ssh"

# Where the tooling is deployed on the head node. Script paths and the default log directory
# derive from it. Optional: unset falls back to the repo root, and a declared topology's scripts
# role root supersedes it.
# RACK_REMOTE_BASE_PATH = "/home/cmsupport/nvis-rack-status"

# Head node for the SSH control connection. Required unless the deployment is in demo mode or
# RACK_EXEC_MODE=local.
# REQUIRED under the condition above — startup refuses, naming this setting, rather than failing
# later.
# RACK_SSH_HOST = "10.0.0.1"

# Path to the private key for the control connection. The path, not the key: the key itself must
# never appear in this file.
# RACK_SSH_KEY = "/run/secrets/ssh_key"

# Port for the SSH control connection.
# RACK_SSH_PORT = 22

# Account for the SSH control connection to the head node.
# RACK_SSH_USER = "root"

# Deprecated. The directory Rack Status ingests node logs from. This is one global value for
# every cluster at once, so a multi-tenant deployment would read a project's logs from a cluster
# it may not operate; set the log directory per cluster instead (the cluster's
# connection.log_dir). Kept only as a fallback for deployments still migrating, and it warns
# when used.
# RACK_STATUS_LOG_DIR = "/home/cmsupport/aihpc_val-main/validation/nemo"


[cluster]
# Cluster manager provider: 'bcm' (Base Command Manager) or 'maas'.
# RACK_PLATFORM = "bcm"

# Skip 'module load slurm' before scheduler commands, for sites where Slurm is already on PATH.
# RACK_SLURM_SKIP_MODULE_LOAD = true


[auth]
# This deployment's own base URL, used as the OIDC `iss` claim. Required when the OIDC provider
# is enabled. Cannot be derived from the request: OIDC Discovery 1.0 §4.3 requires it to be the
# URL discovery is served from, and a Host header is attacker-controlled. http is accepted only
# for localhost, which is how an operator reaches a tunnelled deployment.
# RACK_WEB_OIDC_ISSUER = "https://rackstatus.example.com"


[tls]
# Private key for the TLS certificate. Required whenever RACK_WEB_TLS_CERT is set: a cert with
# no key downgrades one path silently and crashes the other.
# REQUIRED under the condition above — startup refuses, naming this setting, rather than failing
# later.
# RACK_WEB_TLS_KEY = "/app/config/tls/server.key"


[validation]
# LLMB's own image store on the launch host, for presets that stage from it (GPT-OSS). Which
# file and its digest are the cluster's image catalog's. Default /cluster/llmb/images.
# LLMB_IMAGE_ROOT = "/cluster/llmb/images"

# Squashed NeMo container image used by the NeMo validation launchers.
# NEMO_SQSH_SRC = "/cluster/containers/nvidia+nemo+26.04.01-arm.sqsh"

# Fallback for where each compute node caches container images (the cluster's
# connection.node_container_dir wins). Staging copies images here and jobs run them from here.
# Default /tmp/containers.
# NVIS_NODE_CONTAINER_DIR = "/opt/containers"

# Fallback for the cluster's shared container image store (the cluster's
# connection.shared_container_dir wins). Default /cluster/containers.
# RACK_VALIDATION_CONTAINER_ROOT = "/cluster/containers"


[nvftp]
# NVFTP project folder name. Not a credential, despite matching the sensitive-name pattern on
# 'TOKEN'.
# RACK_PROJECT_TOKEN = "my-project"
