#!/usr/bin/env bash
set -euo pipefail

[[ ${1:-} == -c && $# -eq 2 ]] || {
  echo "cmsh read-only wrapper: expected -c QUERY" >&2
  exit 64
}

query=$2
case "$query" in
  "main; versioninfo"|"rack; list"|"ds"|"device; foreach -t physicalnode (get hostname; interfaces; use rf0; get ip)") ;;
  *)
    echo "cmsh read-only wrapper: command denied" >&2
    exit 77
    ;;
esac

printf -v query_q '%q' "$query"
exec ssh \
  -o BatchMode=yes \
  -o IdentitiesOnly=yes \
  -o StrictHostKeyChecking=yes \
  -o UserKnownHostsFile=/run/secrets/known_hosts \
  -i /run/secrets/ssh_key \
  hlakshminara@nscale-16k-hn1 \
  "/cm/local/apps/cmd/bin/cmsh -c $query_q"
