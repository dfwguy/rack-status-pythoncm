# ──────────────────────────────────────────────────────────────────────────────
# NVIS Rack Status — Container Configuration
# Edit this file with your site-specific settings.
# Docker loads it via --env-file or docker-compose env_file.
# ──────────────────────────────────────────────────────────────────────────────

# Remote head node base path — where nvis-rack-status is deployed on the head node.
# All script paths and the default log directory derive from this.
# Scripts:  {RACK_REMOTE_BASE_PATH}/bin/scripts/
# Log dir:  {RACK_REMOTE_BASE_PATH}/var/logs/
RACK_REMOTE_BASE_PATH=/app

# Execution mode: "local" (run commands directly) or "ssh" (SSH to head node)
RACK_EXEC_MODE=local

# Nscale TX 16K identity and BCM 11 platform.
RACK_CLUSTER_ID=nscale-tx
RACK_CLUSTER_NAME=NscaleTX-16K
RACK_CLUSTER_CUSTOMER_NAME=NscaleTX
RACK_CLUSTER_PRODUCT_LINE=GB300
RACK_CLUSTER_HW_VENDOR=NVIDIA
RACK_PLATFORM=bcm

# Nscale primary provider. Feature-specific Slurm/transport fallbacks remain
# enabled for exact recipes with no equivalent PythonCM semantics.
RACK_SCHEDULER=pythoncm
# Command submission remains PythonCM, but rack availability and the node-down
# report are both defined by live Slurm's exact 4,032-node inventory.
RACK_NATIVE_SINFO_SOURCE=slurm
RACK_NODE_DOWN_SHEET_TOKEN_FILE=/run/secrets/gsheets-token
RACK_NODE_DOWN_SHEET_TTL_SEC=120
NVIS_PYTHONCM_SOCKET=/run/nvis-pythoncm/query.sock
NVIS_PYTHONCM_EXEC_SOCKET=/run/nvis-pythoncm/exec.sock
RACK_PYTHONCM_JOBS_DIR=/cluster/OVA/hlakshminara/opt/nscaletx-16k-services/rack-status/var/pythoncm-jobs
RACK_STATUS_BACKGROUND_INTERVAL_SEC=30
# Nscale TX's authoritative rack bringup/status tree. Report generation runs
# these reviewed scripts read-only from the matching host mount in Compose.
RACK_BRINGUP_HOME=/cluster/bringup
# Keep the dashboard's 30-second refresh responsive without allowing a verdict
# cache miss to consume all 128 appserver CPUs.
RACK_BRINGUP_SCAN_JOBS=16
RACK_BRINGUP_FLEET_CACHE_TTL_SEC=300
# Nscale logical rack/tray names span both data halls. BCM Rack entities carry
# physical EH/WH coordinates; PythonCM NodeGroups supply the SU1..SU14 labels.
NVIS_RACK_ID=ink50-dh[01-99]-[a-z][\d+]
RACK_NATIVE_EXPECTED_RACK_NUMBERS=01-08,17-24
NVIS_CT_ID=ink50-dh[01-99]-[a-z][\d+]-[\d+]
NVIS_NVSW_ID=ink50-dh[01-99]-[a-z][\d+]-[\d+]-nv
# Keep this Nscale deployment isolated from legacy/default catalog state in the
# shared /app/var volume. The catalog can still manage Nscale projects/clusters.
NVIS_CATALOG_FILE=/app/var/store/catalog-nscale-tx.json

# PythonCM runs on the BCM head with the BCM-matched interpreter and credentials.
# Defaults shown by backend/bcm_query.py normally work on a stock BCM head.
# NVIS_BCM_PYTHON=/cm/local/apps/python312/bin/python3
# NVIS_PYTHONCM_PATH=/cm/local/apps/cmd/pythoncm
NVIS_BCM_HOST=192.168.10.2
NVIS_BCM_PORT=8081
# NVIS_BCM_CERT=~/.cm/cert.pem
# NVIS_BCM_KEY=~/.cm/cert.key
# NVIS_BCM_CA=~/.cm/cluster-ca.pem
# NVIS_BCM_CA_OUT=~/.cm/cluster-ca.pem
# NVIS_BCM_CA_BOOTSTRAP=0
# NVIS_BCM_USERNAME=
# NVIS_BCM_PASSWORD_FILE=~/.cm/password
# NVIS_BCM_COOKIE_FILE=~/.cm/cookie
# RACK_PYTHONCM_EXEC_SCRIPT=/home/cmsupport/nvis-rack-status/bin/scripts/nvis_pythoncm_exec.py
# RACK_PYTHONCM_JOBS_DIR=/home/cmsupport/nvis-rack-status/var/pythoncm-jobs
# RACK_PYTHONCM_USER=root

# SSH connection — RACK_SSH_HOST must be overridden per site
# Cluster-manager inventory is proxied read-only to the BCM head node. Slurm
# inventory uses the local BCM-managed controller/config mounted from /cm.
RACK_CMSH=/app/bin/cmsh-readonly-16k
RACK_SSH_HOST=192.168.10.2
RACK_SSH_USER=cmods
RACK_SSH_PORT=22
RACK_SSH_KEY=/run/secrets/ssh_key

# Authentication
RACK_WEB_AUTH_MODE=token
# Preferred: set host-side RACK_WEB_AUTH_TOKEN_PATH for Compose; the secret is
# mounted at this in-container path and never copied into container environment.
RACK_WEB_AUTH_TOKEN_FILE=/run/secrets/rack-web-auth-token
# Legacy rolling-upgrade fallback only. Remove after file-backed auth is verified.
# RACK_WEB_AUTH_TOKEN=changeme

# NEMO container image path on the head node
RACK_VALIDATION_CONTAINER_ROOT=/cluster/OVA/containers/nvftp-8k-known-good/20260824
RACK_VALIDATION_NODE_CONTAINER_DIR=/opt/containers
RACK_VALIDATION_PROVENANCE_ROOT=/cluster/OVA/scripts/nscaletx-16k-validation
NEMO_SQSH_SRC=/cluster/OVA/containers/nvftp-8k-known-good/20260824/nvidia+nemo+26.04.01.sqsh

# Shared validation evidence root. Restrict operator-supplied log directories to
# this tree so job stdout remains available to the Rack Status result pipeline.
RACK_STATUS_LOG_DIR=/cluster/OVA/logs/nscaletx-16k-validation
# Keep the historical in-container log root readable for browser sessions that
# persisted it before this migration. New jobs/defaults always use the OVA root.
RACK_STATUS_ALLOWED_PREFIXES=/cluster/OVA/logs,/app/var/logs
# Nscale validation jobs emit Slurm-native .out files; both parser Excel and
# raw-log ZIP exports must select the same artifacts shown by parser results.
RACK_PARSER_EXPORT_GLOB=*.out

# Rack Status uses host networking on this OVA.  Query the deployed
# VictoriaMetrics listener directly; the generic Docker Desktop hostname and
# historical port 8429 are not resolvable here and made every native metrics
# chart return HTTP 502.
RACK_METRICS_URL=http://127.0.0.1:8428

# Slurm — skip module load if sinfo/squeue are already on PATH
RACK_SLURM_SKIP_MODULE_LOAD=1
RACK_SLURM_CONF=/cm/shared/apps/slurm/etc/slurm/slurm.conf
RACK_SLURM_SINFO=/cm/local/apps/slurm/25.05/bin/sinfo
RACK_SLURM_SQUEUE=/cm/local/apps/slurm/25.05/bin/squeue
RACK_SLURM_SACCT=/cm/local/apps/slurm/25.05/bin/sacct
RACK_SLURM_SCONTROL=/cm/local/apps/slurm/25.05/bin/scontrol
RACK_SLURM_SBATCH=/cm/local/apps/slurm/25.05/bin/sbatch
RACK_SLURM_SRUN=/cm/local/apps/slurm/25.05/bin/srun
RACK_SLURM_SCANCEL=/cm/local/apps/slurm/25.05/bin/scancel
# The web container runs as root only to access the mounted Munge socket. Submit
# validation allocations as the cluster operator so BCM/PAM and shared-log ownership
# match interactive production jobs.
RACK_SLURM_SUBMIT_UID=1003
RACK_SLURM_SUBMIT_GID=1003
RACK_SLURM_SUBMIT_HOME=/home/cmods

# Start as an inventory/reporting surface. Mutation paths remain disabled until
# a separate 16K operations review explicitly enables them.
RACK_SLURM_SCANCEL_DISABLED=1
RACK_SCRIPT_SUDO=0

# Validation CT range (nodes per rack, e.g. 01-18 for 18 nodes)
RACK_VALIDATION_CT_RANGE=11-18,28-37

# AI Assistant — set to enable the chat widget
# RACK_AI_API_KEY=nvapi-...
# RACK_AI_ENDPOINT=https://inference-api.nvidia.com/v1/chat/completions
# RACK_AI_MODEL=nvidia/nvidia/nemotron-3-super-v3

# Flask
PORT=5056
