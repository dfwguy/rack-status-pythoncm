# ──────────────────────────────────────────────────────────────────────────────
# NVIS Rack Status — Container Configuration
# Edit this file with your site-specific settings.
# Docker loads it via --env-file or docker-compose env_file.
# ──────────────────────────────────────────────────────────────────────────────

# Remote head node base path — where nvis-rack-status is deployed on the head node.
# All script paths and the default log directory derive from this.
# Scripts:  {RACK_REMOTE_BASE_PATH}/bin/scripts/
# Log dir:  {RACK_REMOTE_BASE_PATH}/var/logs/
RACK_REMOTE_BASE_PATH=/home/cmsupport/nvis-rack-status

# Execution mode: "local" (run commands directly) or "ssh" (SSH to head node)
RACK_EXEC_MODE=ssh

# Platform: "bcm" (NVIDIA Base Command Manager) or "maas" (Canonical MAAS)
RACK_PLATFORM=bcm

# Scheduler/execution provider. PythonCM is the default for BCM deployments in
# this package; "slurm" is an explicit compatibility fallback during migration.
RACK_SCHEDULER=pythoncm

# PythonCM runs on the BCM head with the BCM-matched interpreter and credentials.
# Defaults shown by backend/bcm_query.py normally work on a stock BCM head.
# NVIS_BCM_PYTHON=/cm/local/apps/python312/bin/python3
# NVIS_PYTHONCM_PATH=/cm/local/apps/cmd/pythoncm
# NVIS_BCM_HOST=127.0.0.1
# NVIS_BCM_PORT=8081
# NVIS_BCM_CERT=~/.cm/cert.pem
# NVIS_BCM_KEY=~/.cm/cert.key
# NVIS_BCM_CA=~/.cm/cluster-ca.pem
# NVIS_BCM_CA_OUT=~/.cm/cluster-ca.pem
# NVIS_BCM_CA_BOOTSTRAP=0
# NVIS_BCM_USERNAME=
# NVIS_BCM_PASSWORD_FILE=~/.cm/password
# NVIS_BCM_COOKIE_FILE=~/.cm/cookie
# RACK_PYTHONCM_EXEC_SCRIPT=/home/cmsupport/nvis-rack-status/bin/scripts/nvis_pythoncm_exec.py
# RACK_PYTHONCM_JOBS_DIR=/home/cmsupport/nvis-rack-status/var/pythoncm-jobs
# RACK_PYTHONCM_USER=root

# SSH connection — RACK_SSH_HOST must be overridden per site
# RACK_SSH_HOST=10.0.0.1
RACK_SSH_USER=root
RACK_SSH_PORT=22
RACK_SSH_KEY=/run/secrets/ssh_key

# Authentication
RACK_WEB_AUTH_MODE=token
# RACK_WEB_AUTH_TOKEN=changeme

# NEMO container image path on the head node
NEMO_SQSH_SRC=/cluster/containers/nvidia+nemo+26.04.01-arm.sqsh

# Slurm fallback only — uncomment when RACK_SCHEDULER=slurm.
# RACK_SLURM_SKIP_MODULE_LOAD=1

# Validation CT range (nodes per rack, e.g. 01-18 for 18 nodes)
# RACK_VALIDATION_CT_RANGE=01-18

# AI Assistant — set to enable the chat widget
# RACK_AI_API_KEY=nvapi-...
# RACK_AI_ENDPOINT=https://inference-api.nvidia.com/v1/chat/completions
# RACK_AI_MODEL=nvidia/nvidia/nemotron-3-super-v3

# Flask
PORT=5000
