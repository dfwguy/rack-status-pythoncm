# ──────────────────────────────────────────────────────────────────────────────
# NVIS Rack Status — Container Configuration
# Edit this file with your site-specific settings.
# Docker loads it via --env-file or docker-compose env_file.
# ──────────────────────────────────────────────────────────────────────────────

# Remote head node base path — where nvis-rack-status is deployed on the head node.
# All script paths and the default log directory derive from this.
# Scripts:  {RACK_REMOTE_BASE_PATH}/bin/scripts/
# Log dir:  {RACK_REMOTE_BASE_PATH}/var/logs/
RACK_REMOTE_BASE_PATH=/home/cmsupport/nvis-rack-status

# Execution mode: "local" (run commands directly) or "ssh" (SSH to head node)
RACK_EXEC_MODE=ssh

# Platform: "bcm" (NVIDIA Base Command Manager) or "maas" (Canonical MAAS)
RACK_PLATFORM=bcm

# SSH connection — RACK_SSH_HOST must be overridden per site
# RACK_SSH_HOST=10.0.0.1
RACK_SSH_USER=root
RACK_SSH_PORT=22
RACK_SSH_KEY=/run/secrets/ssh_key

# Authentication
# Nothing to configure. Shared-token and PAM login were removed (FR-18); the app authenticates
# against its own identity store over SRP. On the first start with an empty store it prints a
# one-time `admin` password to the container log:
#
#     docker logs <container> 2>&1 | grep -A6 "ONE-TIME ADMINISTRATOR"
#
# Sign in with it and you will be required to choose your own. The identity store lives on the
# rack-data volume, so it survives a `docker compose up -d` recreate.
#
# RACK_WEB_AUTH_DISABLED=1 turns the gate off entirely, for local development only.

# NEMO container image path on the head node
NEMO_SQSH_SRC=/cluster/containers/nvidia+nemo+26.04.01-arm.sqsh

# Slurm — skip module load if sinfo/squeue are already on PATH
RACK_SLURM_SKIP_MODULE_LOAD=1

# Validation CT range (nodes per rack, e.g. 01-18 for 18 nodes)
# RACK_VALIDATION_CT_RANGE=01-18

# AI Assistant — set to enable the chat widget
# RACK_AI_API_KEY=nvapi-...
# RACK_AI_ENDPOINT=https://inference-api.nvidia.com/v1/chat/completions
# RACK_AI_MODEL=nvidia/nvidia/nemotron-3-super-v3

# Flask
PORT=5000
