# NVIS-P2P site configuration. Values are literal; shell expansion is not used.
NVIS_INSTALL_ROOT=/opt/nvis-p2p
NVIS_SERVICE_USER=nvis-p2p
NVIS_SERVICE_GROUP=nvis-p2p
NVIS_SERVICE_UID=1024
NVIS_SERVICE_GID=1003

# Manager may be separate from the appserver that hosts scheduler, seeds,
# object storage, and the console.
NVIS_MANAGER_IP=192.0.2.10
NVIS_APPSERVER_IP=192.0.2.11
NVIS_CONSOLE_BIND=127.0.0.1:4300

# A single node-list file or a directory plus glob. The renderer creates one
# sorted, unique inventory without modifying the source files.
NVIS_INVENTORY_SOURCE=/srv/nvis/inventory
NVIS_INVENTORY_PATTERN=SU*.nodes

NVIS_CONTAINER_PATH=/cluster/containers
NVIS_CATALOG_PATH=/cluster/containers/.nvis-p2p/catalog/images.json
NVIS_PEER_ROOT=/opt/containers/.nvis-p2p
NVIS_OBJECT_STORE_DATA_PATH=/srv/nvis-p2p/object-store
NVIS_SEED_CACHE_PATH=/srv/nvis-p2p/seed-cache

# Credentials are referenced by file and are never stored in this template.
# Files must already exist and should be mode 0600.
NVIS_POSTGRES_PASSWORD_FILE=/secure/nvis-p2p/postgres-password
NVIS_MANAGER_JWT_KEY_FILE=/secure/nvis-p2p/manager-jwt-key
NVIS_MINIO_ROOT_PASSWORD_FILE=/secure/nvis-p2p/minio-root-password
NVIS_DFSTORE_READONLY_ENV_FILE=/secure/nvis-p2p/dfstore-readonly.env

# Optional TLS material for MinIO. Set both or leave both empty.
NVIS_OBJECT_STORE_CERT_FILE=
NVIS_OBJECT_STORE_KEY_FILE=

# Installer destination for rendered units. It copies units but never runs
# daemon-reload, enable, start, stop, or restart.
NVIS_SYSTEMD_DIR=/etc/systemd/system
