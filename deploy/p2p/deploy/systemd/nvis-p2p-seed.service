[Unit]
Description=NVIS-P2P Dragonfly seed peer 1
After=network-online.target docker.service nvis-p2p-manager.service
Wants=network-online.target

[Service]
Type=simple
User=hlakshminara
Group=cmods
WorkingDirectory=/home/hlakshminara/NVIS-P2P
ExecStart=/home/hlakshminara/NVIS-P2P/dist/client-amd64-v1.4.9/dfdaemon --config /home/hlakshminara/NVIS-P2P/configs/seed.yaml --log-dir /home/hlakshminara/NVIS-P2P/state/seed/logs --console
Restart=always
RestartSec=5s
LimitNOFILE=1048576
TasksMax=8192
StandardOutput=append:/home/hlakshminara/NVIS-P2P/state/seed/dfdaemon-service.log
StandardError=append:/home/hlakshminara/NVIS-P2P/state/seed/dfdaemon-service.log

[Install]
WantedBy=multi-user.target
