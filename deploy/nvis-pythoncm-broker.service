[Unit]
Description=NVIS persistent PythonCM broker
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/cluster /cm /home/hlakshminara/.cm
StartLimitIntervalSec=0

[Service]
Type=simple
User=hlakshminara
Group=cmods
RuntimeDirectory=nvis-pythoncm
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
EnvironmentFile=-/home/hlakshminara/.cm/pythoncm-broker.env
ExecStart=/cm/local/apps/python312/bin/python3 /cluster/OVA/hlakshminara/opt/nscaletx-16k-services/rack-status/bin/scripts/nvis_pythoncm_broker.py --socket /run/nvis-pythoncm/query.sock --services query --backlog 128 --disconnect-timeout 5
Restart=always
RestartSec=3
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
