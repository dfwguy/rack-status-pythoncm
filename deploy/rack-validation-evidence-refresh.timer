[Unit]
Description=Refresh Rack Status validation evidence every 15 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=15min
Persistent=true
AccuracySec=30s
Unit=rack-validation-evidence-refresh.service

[Install]
WantedBy=timers.target
