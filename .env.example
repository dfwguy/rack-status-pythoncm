# ──────────────────────────────────────────────────────────────────────────────
# NVIS Rack Status — Docker Compose interpolation
#
# Copy to `.env` beside docker-compose.yml and fill in.
#
# THIS FILE IS NARROW ON PURPOSE. Compose reads `.env` only to expand `${...}`
# in docker-compose.yml itself — to publish the port and mount the SSH key,
# which Docker resolves *before* the container starts. Nothing here is passed
# into the container as an environment variable, so a setting that
# docker-compose.yml does not interpolate does NOTHING in this file.
#
# WHERE EVERYTHING ELSE GOES — two files, two jobs:
#
#   .env                     →  this file. Compose interpolation only (the 3 below).
#   config/rackstatus.toml   →  every setting the app reads. Mounted read-only at
#                               /app/config. Create the minimal one with
#                                 python3 backend/cli.py init-config --ssh-host <head>
#                               and copy more from config/rackstatus.toml.example.
#
# TLS is always on. Put your certificate at config/tls/server.crt and
# config/tls/server.key; without one, a self-signed certificate is generated on
# first start and kept on the rack-data volume.
# ──────────────────────────────────────────────────────────────────────────────

# Address the published port binds to. Loopback by default, deliberately: with
# no bind address Docker publishes on 0.0.0.0, and on the Nscale TX OVA that
# exposed the dashboard to anything routable on the management segment. Every
# documented access path is an SSH tunnel, which terminates on the host and
# reaches loopback fine. Widen this only on purpose.
RACK_WEB_BIND_ADDR=127.0.0.1

# Host port. The container always listens on 5000 internally, over HTTPS.
RACK_WEB_PORT=5000

# Private key mounted read-only at /run/secrets/ssh_key, where the app looks by
# default. The host path, not the key: never put key material in this file.
RACK_SSH_KEY_PATH=~/.ssh/id_rsa
