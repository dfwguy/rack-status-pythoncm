# ──────────────────────────────────────────────────────────────────────────────
# NVIS Rack Status — Docker environment
# Copy this file to .env and fill in site-specific values.
# ──────────────────────────────────────────────────────────────────────────────

# Execution mode: "local" (run commands directly) or "ssh" (SSH to head node)
RACK_EXEC_MODE=ssh

# Platform: "bcm" (NVIDIA Base Command Manager) or "maas" (Canonical MAAS)
RACK_PLATFORM=bcm

# PythonCM/direct execution is the primary BCM scheduler. Use "slurm" only as
# an explicit compatibility fallback while migrating an existing deployment.
RACK_SCHEDULER=pythoncm

# Optional PythonCM overrides on the BCM head.
# NVIS_BCM_PYTHON=/cm/local/apps/python312/bin/python3
# NVIS_PYTHONCM_PATH=/cm/local/apps/cmd/pythoncm
# NVIS_BCM_HOST=127.0.0.1
# NVIS_BCM_PORT=8081
# NVIS_BCM_CERT=~/.cm/cert.pem
# NVIS_BCM_KEY=~/.cm/cert.key
# NVIS_BCM_CA=~/.cm/cluster-ca.pem
# NVIS_BCM_CA_OUT=~/.cm/cluster-ca.pem
# NVIS_BCM_CA_BOOTSTRAP=0
# NVIS_BCM_USERNAME=
# NVIS_BCM_PASSWORD_FILE=~/.cm/password
# NVIS_BCM_COOKIE_FILE=~/.cm/cookie
# RACK_PYTHONCM_EXEC_SCRIPT=/home/cmsupport/nvis-rack-status/bin/scripts/nvis_pythoncm_exec.py
# RACK_PYTHONCM_JOBS_DIR=/home/cmsupport/nvis-rack-status/var/pythoncm-jobs
# RACK_PYTHONCM_USER=root

# Head-node hostname or IP (required when RACK_EXEC_MODE=ssh)
RACK_SSH_HOST=10.0.0.1

# SSH user and key for connecting to the head node
RACK_SSH_USER=root
RACK_SSH_KEY_PATH=~/.ssh/id_rsa
RACK_SSH_PORT=22

# Web server port (host side)
RACK_WEB_PORT=5000

# Log directory on the host (bind-mounted into the container)
RACK_LOG_DIR=./var/logs

# Authentication: "token" (use RACK_WEB_AUTH_TOKEN) or set RACK_WEB_AUTH_DISABLED=1
RACK_WEB_AUTH_MODE=token
RACK_WEB_AUTH_TOKEN=changeme
# RACK_WEB_AUTH_DISABLED=1

# Demo mode: set to 1 for synthetic data (no cluster access needed)
RACK_STATUS_DEMO=0
