# ──────────────────────────────────────────────────────────────────────────────
# NVIS Greenlight — Docker Compose interpolation
#
# Copy to `.env` beside docker-compose.yml and fill in.
#
# THIS FILE IS NARROW ON PURPOSE. Compose reads `.env` only to expand `${...}`
# in docker-compose.yml itself — to publish ports and build bind mounts, which
# Docker resolves *before* the container starts. Nothing here is passed into
# the container as an environment variable.
#
# So a setting that is not interpolated by docker-compose.yml does NOTHING in
# this file. That is what was wrong with the previous version: it offered
# RACK_EXEC_MODE, RACK_PLATFORM, RACK_SSH_USER, RACK_SSH_PORT, RACK_LOG_DIR and
# RACK_STATUS_DEMO, none of which Compose interpolates, so an operator setting
# RACK_STATUS_DEMO=1 here got no demo mode and no error. It also still listed
# RACK_WEB_AUTH_MODE and RACK_WEB_AUTH_TOKEN, which were deleted with the
# shared-token and PAM login paths — configuring authentication that no longer
# exists.
#
# WHERE EVERYTHING ELSE GOES — three files, three jobs:
#
#   .env               →  this file. Compose interpolation only (the 6 below).
#   rack-config.env    →  passed into the container via `env_file`. Runtime
#                         settings the app reads: exec mode, platform, ssh user
#                         and port, remote base path.
#   greenlight.toml    →  read by the app itself at launch, and the preferred
#                         home for anything not in the two above. Copy
#                         greenlight.toml.example. The environment overrides it,
#                         so these two files still win where they overlap.
# ──────────────────────────────────────────────────────────────────────────────

# Address the published port binds to. Loopback by default, deliberately: with
# no bind address Docker publishes on 0.0.0.0, and on the Nscale TX OVA that
# made the dashboard answer plaintext HTTP to anything routable on the
# management segment. Every documented access path is an SSH tunnel, which
# terminates on the host and reaches loopback fine. Read docs/ENVIRONMENT.md §4
# about TLS before widening this.
RACK_WEB_BIND_ADDR=127.0.0.1

# Host port. The container always listens on 5000 internally.
RACK_WEB_PORT=5000

# Head node for the SSH control connection. Required unless the deployment runs
# in demo mode or with a local execution target — the app refuses to start
# without it and will name it.
RACK_SSH_HOST=10.0.0.1

# Private key mounted read-only at /run/secrets/ssh_key. The host path, not the
# key: never put key material in this file.
RACK_SSH_KEY_PATH=~/.ssh/id_rsa

# TLS. Point these at bin/gen-tls-cert.py output to serve HTTPS; leave unset for
# plain HTTP behind a tunnel. Setting the cert without the key is refused at
# startup — a cert with no key downgrades one path silently and crashes the
# other, so it is better to fail at launch.
RACK_WEB_TLS_CERT=
RACK_WEB_TLS_KEY=
